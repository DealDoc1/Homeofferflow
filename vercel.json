{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/fill-pdf.py": {
      "includeFiles": "{buyer_temporary_residential_lease_16-7.pdf,seller_temporary_residential_lease_15-7.pdf}"
    }
  },
  "rewrites": [
    {
      "source": "/investors",
      "destination": "/investors.html"
    },
    {
      "source": "/agents",
      "destination": "/agents.html"
    },
    {
      "source": "/buyers",
      "destination": "/buyers.html"
    },
    {
      "source": "/ondemand",
      "destination": "/ondemand.html"
    },
    {
      "source": "/partners",
      "destination": "/partners.html"
    },
    {
      "source": "/texas-home-service-partner-guide",
      "destination": "/texas-home-service-partner-guide.html"
    },
    {
      "source": "/sellers",
      "destination": "/sellers.html"
    },
    {
      "source": "/texas-fsbo-guide",
      "destination": "/texas-fsbo-guide.html"
    },
    {
      "source": "/texas-seller-offer-review",
      "destination": "/texas-seller-offer-review.html"
    },
    {
      "source": "/texas-agent-offer-workflow",
      "destination": "/texas-agent-offer-workflow.html"
    },
    {
      "source": "/texas-lease-offer-workflow",
      "destination": "/texas-lease-offer-workflow.html"
    },
    {
      "source": "/texas-listing-workflow",
      "destination": "/texas-listing-workflow.html"
    },
    {
      "source": "/texas-homebuyer-offer-guide",
      "destination": "/texas-homebuyer-offer-guide.html"
    },
    {
      "source": "/texas-investor-offer-guide",
      "destination": "/texas-investor-offer-guide.html"
    },
    {
      "source": "/texas-agent-form-library",
      "destination": "/texas-agent-form-library.html"
    },
    {
      "source": "/texas-seller-financing-guide",
      "destination": "/texas-seller-financing-guide.html"
    },
    {
      "source": "/texas-buyer-representation-guide",
      "destination": "/texas-buyer-representation-guide.html"
    },
    {
      "source": "/directory",
      "destination": "/directory.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    },
    {
      "source": "/assets/homeofferflow-app-icon-192.png",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800"}]
    },
    {
      "source": "/assets/homeofferflow-app-icon-512.png",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800"}]
    },
    {
      "source": "/assets/homeofferflow-apple-touch-icon.png",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800"}]
    },
    {
      "source": "/assets/homeofferflow-social-preview-v1.png",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800"}]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' 'unsafe-inline' 'unsafe-eval' https://maps.googleapis.com https://maps.gstatic.com https://js.stripe.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://maps.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src * data: blob:; connect-src *; frame-src https://js.stripe.com; worker-src 'self' blob:;"
        }
      ]
    },
    {
      "source": "/(manifest\\.webmanifest|sitemap\\.xml|robots\\.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
