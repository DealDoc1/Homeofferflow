{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/fill-pdf.py": {
      "includeFiles": "{buyer_temporary_residential_lease_16-7.pdf,seller_temporary_residential_lease_15-7.pdf}"
    }
  },
  "rewrites": [
    {
      "source": "/investors",
      "destination": "/investors.html"
    },
    {
      "source": "/agents",
      "destination": "/agents.html"
    },
    {
      "source": "/buyers",
      "destination": "/buyers.html"
    },
    {
      "source": "/ondemand",
      "destination": "/ondemand.html"
    },
    {
      "source": "/partners",
      "destination": "/partners.html"
    },
    {
      "source": "/sellers",
      "destination": "/sellers.html"
    },
    {
      "source": "/texas-fsbo-guide",
      "destination": "/texas-fsbo-guide.html"
    },
    {
      "source": "/texas-agent-offer-workflow",
      "destination": "/texas-agent-offer-workflow.html"
    },
    {
      "source": "/directory",
      "destination": "/directory.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' 'unsafe-inline' 'unsafe-eval' https://maps.googleapis.com https://maps.gstatic.com https://js.stripe.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://maps.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src * data: blob:; connect-src *; frame-src https://js.stripe.com; worker-src 'self' blob:;"
        }
      ]
    }
  ]
}
