{
  "name": "HomeOfferFlow",
  "short_name": "HomeOfferFlow",
  "description": "Prepare Texas real estate offers, shared agent form drafts, listing tools, and signing follow-up in one lightweight workspace.",
  "categories": ["business", "productivity", "real estate"],
  "lang": "en-US",
  "dir": "ltr",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "share_target": {
    "action": "/?pwa_share=1",
    "method": "GET",
    "params": {"title": "title", "text": "text", "url": "url"}
  },
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "shortcuts": [
    {
      "name": "Start a Transaction",
      "short_name": "Start",
      "description": "Choose listing, buying, lease listing, or lease representation.",
      "url": "/?pwa_action=transaction_start",
      "icons": [{"src":"/assets/homeofferflow-app-icon-192.png","sizes":"192x192","type":"image/png"}]
    },
    {
      "name": "My Workspace",
      "short_name": "Workspace",
      "description": "Open your HomeOfferFlow agent workspace.",
      "url": "/?pwa_action=workspace",
      "icons": [{"src":"/assets/homeofferflow-app-icon-192.png","sizes":"192x192","type":"image/png"}]
    },
    {
      "name": "Needs Attention",
