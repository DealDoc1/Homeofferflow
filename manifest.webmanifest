{
  "name": "HomeOfferFlow",
  "short_name": "HomeOfferFlow",
  "description": "Prepare Texas real estate offers, shared agent form drafts, listing tools, and signing follow-up in one lightweight workspace.",
  "lang": "en-US",
  "dir": "ltr",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "shortcuts": [
    {
      "name": "My Workspace",
      "short_name": "Workspace",
      "description": "Open your HomeOfferFlow agent workspace.",
      "url": "/?pwa_action=workspace"
    },
    {
      "name": "Start a Transaction",
      "short_name": "Start",
      "description": "Choose listing, buying, lease listing, or lease representation.",
      "url": "/?pwa_action=transaction_start",
      "icons": [{"src":"/assets/homeofferflow-app-icon-192.png","sizes":"192x192","type":"image/png"}]
    },
    {
      "name": "Listing Tools",
      "short_name": "Listings",
      "description": "Open private seller leads, listing workspaces, launch planning, and offer comparison tools.",
      "url": "/?pwa_action=listing_tools"
    },
    {
      "name": "Agent Forms & Drafts",
      "short_name": "Agent Forms",
      "description": "Open the private agent form library, relationship drafts, and review workflows.",
      "url": "/?pwa_action=relationship_drafts",
      "icons": [{"src":"/assets/homeofferflow-app-icon-192.png","sizes":"192x192","type":"image/png"}]
    },
    {
      "name": "Offer Review",
      "short_name": "Review",
      "description": "Open the private offer-strength and risk review workspace.",
      "url": "/?pwa_action=offer_review"
    },
    {
      "name": "New Offer",
      "short_name": "New Offer",
      "description": "Start or resume a saved offer in your workspace.",
      "url": "/?pwa_action=new_offer"
    },
    {
      "name": "Buyer Offer",
      "short_name": "Buyer Offer",
      "description": "Start a self-serve Texas homebuyer offer before checkout.",
      "url": "/?pwa_action=buyer_offer"
    },
    {
      "name": "Signing Queue",
      "short_name": "Signing",
      "description": "Review buyer packets awaiting signature.",
      "url": "/?pwa_action=signing_queue"
    },
    {
      "name": "Needs Attention",
      "short_name": "Attention",
      "description": "Open stale drafts, waiting signatures, and expired signing recovery work.",
      "url": "/?pwa_action=attention_queue"
    },
    {
      "name": "Seller Plan",
      "short_name": "Seller Plan",
      "description": "Return to the FSBO seller plan and package request.",
      "url": "/?pwa_action=seller_plan"
    },
    {
      "name": "Investor Workspace",
      "short_name": "Investor",
      "description": "Open your private investor workspace for repeat-offer work.",
      "url": "/?pwa_action=investor_workspace"
    },
    {
      "name": "Partner Marketplace",
      "short_name": "Partners",
      "description": "Browse partner services and partner onboarding options.",
      "url": "/?pwa_action=partner_marketplace"
    },
    {
      "name": "Find a Provider",
      "short_name": "Providers",
      "description": "Browse active Texas home-service provider profiles by category and market.",
      "url": "/directory?utm_source=pwa_shortcut&utm_medium=installed_app&utm_campaign=provider_directory",
      "icons": [{"src":"/assets/homeofferflow-app-icon-192.png","sizes":"192x192","type":"image/png"}]
    }
  ],
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "display": "standalone",
  "orientation": "portrait-primary",
  "prefer_related_applications": false,
  "background_color": "#f5f7f6",
  "theme_color": "#173f35",
  "icons": [
    {
      "src": "/assets/homeofferflow-app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/assets/homeofferflow-app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/assets/homeofferflow-app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
